{
  "name": "create-my-node-backend",
  "version": "1.0.9",
  "description": "CLI tool to generate backend boilerplate projects",
  "bin": {
    "create-my-node-backend": "index.js",
    "create-my-backend": "index.js"
  },
  "preferGlobal": true,
  "files": [
    "index.js",
    "README.md",
    "boilerplate/package.json",
    "boilerplate/package-lock.json",
    "boilerplate/src",
    "boilerplate/config",
    "boilerplate/Dockerfile",
    "boilerplate/docker-compose.yml",
    "boilerplate/.dockerignore",
    "boilerplate/.env"
  ],
  "keywords": [
    "cli",
    "boilerplate",
    "backend"
  ],
  "author": "Akshat Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshat231/node-backend-boilerplate.git"
  },
  "homepage": "https://github.com/akshat231/node-backend-boilerplate#readme"
}
